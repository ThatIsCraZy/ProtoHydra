<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DataService.App.Views.ConfirmationWindow"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        UseLayoutRounding="True"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="18" Spacing="14">
    <TextBlock x:Name="HeadlineText"
               FontSize="15"
               FontWeight="SemiBold"
               TextWrapping="Wrap" />
    <TextBlock x:Name="MessageText"
               Classes="caption"
               TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_OnClick" IsCancel="True" />
      <Button x:Name="ConfirmButton" Classes="primary" Click="Confirm_OnClick" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
